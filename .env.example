# Server Port
SERVER_PORT=9090
SERVER_DOMAIN=localhost

# admin properties
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Choose Database Type (postgres, mysql, sqlite3)
DB_TYPE=postgres

# PostgreSQL Configuration
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=messaging_service
# DB_SSLMODE=disable  # Change to "require" for production

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=messaging_service

# SQLite Configuration (if DB_TYPE=sqlite, this file will be used)
# DB_NAME=database.sqlite

# Redis Configuration (for message queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0  # Default DB
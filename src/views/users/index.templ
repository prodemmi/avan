package users

import (
	"avan/internal/db/sqlc"
	"fmt"
)

templ Index(userList []sqlc.GetUsersPostgresqlRow) {
	<div class="flex items-center justify-between mb-6">
		<div>
			<h1 class="text-2xl font-bold">Users</h1>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">People in this workspace</p>
		</div>
		<span class="rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-700">{ fmt.Sprint(len(userList)) }</span>
	</div>
	if len(userList) == 0 {
		<div class="rounded-xl border border-gray-200 bg-white p-10 text-center dark:border-gray-700 dark:bg-gray-800">
			<i class="ri-user-search-line text-4xl text-gray-400" aria-hidden="true"></i>
			<h2 class="mt-3 text-lg font-semibold">No users found</h2>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Users assigned to this workspace will appear here.</p>
		</div>
	} else {
		<div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
			<table class="w-full text-left text-sm rtl:text-right">
				<thead class="bg-gray-50 text-xs uppercase text-gray-500 dark:bg-gray-700 dark:text-gray-300">
					<tr>
						<th scope="col" class="px-5 py-4">Name</th>
						<th scope="col" class="px-5 py-4">Email</th>
						<th scope="col" class="px-5 py-4">Mobile</th>
						<th scope="col" class="px-5 py-4">Joined</th>
					</tr>
				</thead>
				<tbody>
					for _, user := range userList {
						<tr class="border-t border-gray-100 dark:border-gray-700">
							<td class="px-5 py-4 font-medium text-gray-900 dark:text-white">{ user.Name }</td>
							<td class="px-5 py-4 text-gray-600 dark:text-gray-300">{ user.Email }</td>
							<td class="px-5 py-4 text-gray-600 dark:text-gray-300">
								if user.Mobile != nil && *user.Mobile != "" {
									{ *user.Mobile }
								} else {
									<span class="text-gray-400">—</span>
								}
							</td>
							<td class="px-5 py-4 text-gray-500 dark:text-gray-400">
								if user.CreatedAt != nil {
									{ user.CreatedAt.Format("Jan 2, 2006") }
								} else {
									<span>—</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

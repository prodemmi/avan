package edit_config_forms

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
)

templ TelegramForm(config sqlc.TelegramConfig) {
	<div class="provider-fields">
		<div class="provider-field provider-field-wide"><label for="bot_token">Bot token</label>@components.OptionalPasswordInput("bot_token", "Leave blank to keep current", "")<p>For security, the saved token is not shown.</p></div>
	</div>
}

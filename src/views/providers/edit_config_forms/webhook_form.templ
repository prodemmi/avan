package edit_config_forms

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
)

templ WebhookForm(config sqlc.WebhookConfig) {
	<div class="provider-fields">
		<div class="provider-field provider-field-wide"><label for="webhook_url">Webhook URL</label>@components.UrlInput("webhook_url", "https://example.com/webhook", config.Url)<p>Avan sends this endpoint a JSON request when a message is queued.</p></div>
	</div>
}

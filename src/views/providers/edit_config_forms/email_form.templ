package edit_config_forms

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
)

templ EmailForm(config sqlc.EmailConfig) {
	<div class="provider-fields">
		<div class="provider-field"><label for="smtp_host">SMTP host</label>@components.Input("smtp_host", "smtp.example.com", config.SmtpHost)</div>
		<div class="provider-field"><label for="smtp_port">SMTP port</label>@components.NumberInput("smtp_port", "587", &config.SmtpPort)</div>
		<div class="provider-field"><label for="username">Username <span>(optional)</span></label>{{username := ""; if config.Username != nil { username = *config.Username }}}@components.OptionalInput("username", "SMTP username", username)</div>
		<div class="provider-field"><label for="password">Password <span>(optional)</span></label>@components.OptionalPasswordInput("password", "Leave blank to keep current", "")<p>For security, the saved password is not shown.</p></div>
		<div class="provider-field provider-field-wide"><label for="from_email">From email</label>@components.Input("from_email", "notifications@example.com", config.FromEmail)</div>
	</div>
}

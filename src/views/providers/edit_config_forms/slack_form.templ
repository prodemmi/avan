package edit_config_forms

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
)

templ SlackForm(provider sqlc.SlackConfig) {
	<div class="flex flex-col gap-4">
		<div>
			<label class="block text-gray-700 text-sm font-bold mb-2 dark:text-gray-300" for="webhook_url">
				Webhook URL
			</label>
			@components.UrlInput("slack_webhook_url", "Enter Slack webhook URL", "")
		</div>
	</div>
}

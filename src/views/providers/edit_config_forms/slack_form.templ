package edit_config_forms

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
)

templ SlackForm(config sqlc.SlackConfig) {
	<div class="provider-fields">
		<div class="provider-field provider-field-wide"><label for="slack_webhook_url">Slack webhook URL</label>@components.UrlInput("slack_webhook_url", "https://hooks.slack.com/services/...", config.WebhookUrl)</div>
	</div>
}

package providers

import (
	"avan/views/components"
	"avan/views/providers/create_config_forms"
	"fmt"
)

templ Create(configType string) {
	<div class="provider-form-page">
		<a class="provider-back-link" href="/dashboard/providers/">← Back to providers</a>
		<div class="provider-form-heading">
			<span class="provider-form-icon"><i class="ri-plug-2-line" aria-hidden="true"></i></span>
			<div><span class="admin-eyebrow">NEW INTEGRATION</span><h1>Create provider</h1><p>Connect a service to deliver messages from this workspace.</p></div>
		</div>
		<form class="provider-config-form" action={ templ.URL(fmt.Sprintf("/dashboard/providers/create/%s", configType)) } method="POST">
			<section class="provider-form-card">
				<div class="provider-form-section-heading"><span class="provider-form-step">1</span><div><h2>Provider details</h2><p>Give this connection a recognizable name and choose its channel.</p></div></div>
				<div class="provider-fields">
					<div class="provider-field">
						<label for="name">Provider name</label>
						@components.Input("name", "Enter provider name", "")
						<p>Use a short name your team will recognize.</p>
					</div>
					<div class="provider-field">
						<label for="type">Channel</label>
						{{ options := []components.SelectOption{{Value: "sms", Label: "Sms"}, {Value: "email", Label: "Email"}, {Value: "telegram", Label: "Telegram"}, {Value: "slack", Label: "Slack"}, {Value: "webhook", Label: "Webhook"}} }}
						@components.Select("type", options, configType)
					</div>
				</div>
			</section>
			<section class="provider-form-card">
				<div class="provider-form-section-heading"><span class="provider-form-step">2</span><div><h2>Connection settings</h2><p>Enter the credentials and endpoint for this provider.</p></div></div>
				switch configType {
					case "sms":
						@create_config_forms.SmsForm()
					case "email":
						@create_config_forms.EmailForm()
					case "telegram":
						@create_config_forms.TelegramForm()
					case "slack":
						@create_config_forms.SlackForm()
					case "webhook":
						@create_config_forms.WebhookForm()
				}
			</section>
			<div class="provider-form-actions">
				<a class="provider-cancel-button" href="/dashboard/providers/">Cancel</a>
				<button class="provider-save-button" type="submit"><i class="ri-check-line" aria-hidden="true"></i>Create provider</button>
			</div>
		</form>
	</div>
	<script>
        const typeValue = document.querySelector("[name=type]");
        typeValue?.addEventListener("change", (event) => {
            location.href = "/dashboard/providers/create/" + event.target.value;
        });
    </script>
}

package providers

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
	"avan/views/providers/edit_config_forms"
	"fmt"
	"strings"
)

templ Edit(provider sqlc.Provider, configType string, config interface{}, securityPolicy string) {
	<div class="provider-form-page">
		<a class="provider-back-link" href="/dashboard/providers/">← Back to providers</a>
		<div class="provider-form-heading">
			<span class="provider-form-icon"><i class="ri-settings-3-line" aria-hidden="true"></i></span>
			<div><span class="admin-eyebrow">PROVIDER SETTINGS</span><h1>Edit provider</h1><p>Update the connection details for <strong>{ provider.Name }</strong>.</p></div>
		</div>
		<form class="provider-config-form" action={ templ.URL(fmt.Sprintf("/dashboard/providers/%d/edit", provider.ID)) } method="POST">
			<section class="provider-form-card">
				<div class="provider-form-section-heading"><span class="provider-form-step"><i class="ri-edit-line" aria-hidden="true"></i></span><div><h2>Provider details</h2><p>Update the display name and failover order.</p></div></div>
				<div class="provider-fields">
					<div class="provider-field"><label for="name">Provider name</label>@components.Input("name", "Enter provider name", provider.Name)</div>
					<div class="provider-field provider-channel-summary"><span>Channel</span><strong>{ strings.ToUpper(configType) }</strong></div>
					<div class="provider-field"><label for="priority">Failover priority</label>@components.NumberInput("priority", "0", &provider.Priority)<p>Lower values are tried first after the selected provider fails.</p></div>
					<div class="provider-field"><label for="weight">Failover weight</label>@components.NumberInput("weight", "1", &provider.Weight)<p>Higher weight is more likely to be tried first among equal-priority backups.</p></div>
				</div>
			</section>
			<section class="provider-form-card">
				<div class="provider-form-section-heading"><span class="provider-form-step">2</span><div><h2>Connection settings</h2><p>Credentials are stored with this workspace provider.</p></div></div>
				switch configType {
					case "sms":
						@edit_config_forms.SmsForm(config.(sqlc.SmsConfig))
					case "email":
						@edit_config_forms.EmailForm(config.(sqlc.EmailConfig))
					case "telegram":
						@edit_config_forms.TelegramForm(config.(sqlc.TelegramConfig))
					case "slack":
						@edit_config_forms.SlackForm(config.(sqlc.SlackConfig))
					case "webhook":
						@edit_config_forms.WebhookForm(config.(sqlc.WebhookConfig))
				}
			</section>
			<section class="provider-form-card">
				<div class="provider-form-section-heading"><span class="provider-form-step"><i class="ri-shield-check-line" aria-hidden="true"></i></span><div><h2>Provider API security</h2><p>Optional restrictions are combined with this workspace’s API security policy.</p></div></div>
				<div class="provider-field provider-field-wide">
					<label for="security_policy">Security policy (JSON)</label>
					@components.Textarea("security_policy", `{"ip_allowlist":["203.0.113.0/24"],"api_key_allowlist":[12]}`, securityPolicy)
					<p>Use <code>ip_allowlist</code> and <code>api_key_allowlist</code>. Empty lists add no restriction.</p>
				</div>
			</section>
			<div class="provider-form-actions">
				<a class="provider-cancel-button" href="/dashboard/providers/">Cancel</a>
				<button class="provider-save-button" type="submit"><i class="ri-check-line" aria-hidden="true"></i>Save changes</button>
			</div>
		</form>
	</div>
}

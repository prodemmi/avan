package create_config_forms

import "avan/views/components"

templ SmsForm() {
	<div class="provider-fields">
		<div class="provider-field provider-field-wide">
			<label for="sms_url">Provider URL</label>
			@components.UrlInput("sms_url", "https://api.example.com/send", "")
			<p>Use <code>$send_to</code> and <code>$message</code> in a GET URL when your gateway expects query parameters.</p>
		</div>
		<div class="provider-field">
			<label for="sms_method">HTTP method</label>
			{{ options := []components.SelectOption{{Value: "0", Label: "GET"}, {Value: "1", Label: "POST"}} }}
			@components.Select("sms_method", options, "0")
		</div>
		<div id="sms-post-body" class="provider-field provider-field-wide sms-post-body hidden">
			<label for="sms_body_schema">POST body template (JSON)</label>
			<textarea class="provider-json-editor" id="sms_body_schema" name="sms_body_schema" rows="8" spellcheck="false">{ `{"to":"$send_to","message":"$message"}` }</textarea>
			<p>Available variables: <code>$send_to</code>, <code>$message</code>, <code>$payload</code>, <code>$retry</code>, <code>$schedule_at</code>, <code>$provider_id</code>, <code>$template_id</code>, <code>$workspace_id</code>. <code>$payload</code> inserts a JSON object and <code>$retry</code> a boolean.</p>
		</div>
		<div class="provider-field provider-field-inline">
			<label for="sms_is_auth_in_header">Send auth in header</label>
			@components.Checkbox("sms_is_auth_in_header", false)
		</div>
		<div class="provider-field">
			<label for="sms_auth_token_key">Auth token key</label>
			@components.OptionalInput("sms_auth_token_key", "e.g. Authorization", "")
		</div>
		<div class="provider-field">
			<label for="sms_auth_token_value">Auth token value</label>
			@components.OptionalPasswordInput("sms_auth_token_value", "Enter token value", "")
		</div>
	</div>
	<script>
		const methodSelect = document.getElementById("sms_method");
		const bodySchema = document.getElementById("sms-post-body");
		const updateBodyVisibility = () => bodySchema?.classList.toggle("hidden", methodSelect?.value !== "1");
		methodSelect?.addEventListener("change", updateBodyVisibility);
		updateBodyVisibility();
	</script>
}

package create_config_forms

import "avan/views/components"

templ SmsForm(url string, method string, authKey string, authType string, bodyEncoding string, bodySchema string) {
	{{ if method == "" { method = "0" } }}
	{{ if authType == "" { authType = "token" } }}
	{{ if bodyEncoding == "" { bodyEncoding = "json" } }}
	{{ if bodySchema == "" { bodySchema = `{"to":"$send_to","message":"$message"}` } }}
	<div class="provider-fields">
		<div class="provider-field provider-field-wide">
			<label for="sms_url">Provider URL</label>
			@components.UrlInput("sms_url", "https://api.example.com/send", url)
			<p>Use <code>$send_to</code>, <code>$message</code>, and <code>$account_sid</code> URL placeholders where applicable.</p>
		</div>
		<div class="provider-field">
			<label for="sms_method">HTTP method</label>
			{{ methodOptions := []components.SelectOption{{Value: "0", Label: "GET"}, {Value: "1", Label: "POST"}} }}
			@components.Select("sms_method", methodOptions, method)
		</div>
		<div id="sms-post-options" class="provider-field provider-field-wide">
			<div class="provider-field">
				<label for="sms_body_encoding">POST body encoding</label>
				{{ encodingOptions := []components.SelectOption{{Value: "json", Label: "JSON"}, {Value: "form", Label: "application/x-www-form-urlencoded"}} }}
				@components.Select("sms_body_encoding", encodingOptions, bodyEncoding)
			</div>
			<div class="provider-field provider-field-wide">
				<label id="sms-body-schema-label" for="sms_body_schema">POST body template</label>
				<textarea class="provider-json-editor" id="sms_body_schema" name="sms_body_schema" rows="8" spellcheck="false">{ bodySchema }</textarea>
				<p>Enter a JSON object. Form encoding sends scalar fields; available variables include <code>$send_to</code>, <code>$message</code>, <code>$sender</code>, <code>$username</code>, <code>$payload</code>, <code>$retry</code>, <code>$schedule_at</code>, <code>$provider_id</code>, <code>$template_id</code>, and <code>$workspace_id</code>.</p>
			</div>
		</div>
		<div class="provider-field">
			<label for="sms_auth_type">Authentication type</label>
			{{ authOptions := []components.SelectOption{{Value: "token", Label: "Token / custom header"}, {Value: "basic", Label: "HTTP Basic"}} }}
			@components.Select("sms_auth_type", authOptions, authType)
		</div>
		<div id="sms-auth-username" class="provider-field">
			<label id="sms-auth-username-label" for="sms_auth_username">Request username</label>
			@components.OptionalInput("sms_auth_username", "API username or Basic Auth username", "")
		</div>
		<div id="sms-account-sid" class="provider-field">
			<label for="sms_account_sid">Account SID</label>
			@components.OptionalInput("sms_account_sid", "Required when the endpoint uses $account_sid", "")
		</div>
		<div id="sms-sender" class="provider-field">
			<label for="sms_sender">Sender number / ID</label>
			@components.OptionalInput("sms_sender", "Provider sender number or ID", "")
		</div>
		<div id="sms-header-auth" class="provider-field provider-field-inline">
			<label for="sms_is_auth_in_header">Send token in header</label>
			@components.Checkbox("sms_is_auth_in_header", false)
		</div>
		<div id="sms-auth-key" class="provider-field">
			<label for="sms_auth_token_key">Auth token key</label>
			@components.OptionalInput("sms_auth_token_key", "e.g. Authorization or password", authKey)
		</div>
		<div class="provider-field">
			<label id="sms-auth-value-label" for="sms_auth_token_value">Auth token value</label>
			@components.OptionalPasswordInput("sms_auth_token_value", "Enter token or password", "")
		</div>
	</div>
	<script>
		const methodSelect = document.getElementById("sms_method");
		const encodingSelect = document.getElementById("sms_body_encoding");
		const authTypeSelect = document.getElementById("sms_auth_type");
		const postOptions = document.getElementById("sms-post-options");
		const usernameField = document.getElementById("sms-auth-username");
		const usernameLabel = document.getElementById("sms-auth-username-label");
		const accountSIDField = document.getElementById("sms-account-sid");
		const senderField = document.getElementById("sms-sender");
		const headerAuthField = document.getElementById("sms-header-auth");
		const authKeyField = document.getElementById("sms-auth-key");
		const authValueLabel = document.getElementById("sms-auth-value-label");
		const bodySchemaLabel = document.getElementById("sms-body-schema-label");
		const updateVisibility = () => {
			const isPost = methodSelect?.value === "1";
			const isForm = encodingSelect?.value === "form";
			const isBasic = authTypeSelect?.value === "basic";
			postOptions.hidden = !isPost;
			usernameField.hidden = !isBasic && !(isPost && isForm);
			accountSIDField.hidden = !isBasic;
			senderField.hidden = !(isPost && isForm);
			headerAuthField.hidden = isBasic;
			authKeyField.hidden = isBasic;
			usernameLabel.textContent = isBasic ? "Basic Auth username (API Key SID)" : "Request username";
			authValueLabel.textContent = isBasic ? "Basic Auth password / API key secret" : "Auth token value";
			bodySchemaLabel.textContent = isForm ? "POST form fields (JSON object)" : "POST body template (JSON)";
		};
		methodSelect?.addEventListener("change", updateVisibility);
		encodingSelect?.addEventListener("change", updateVisibility);
		authTypeSelect?.addEventListener("change", updateVisibility);
		updateVisibility();
	</script>
}

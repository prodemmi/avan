package create_config_forms

import "avan/views/components"

templ TelegramForm() {
	<div class="provider-fields">
		<div class="provider-field provider-field-wide"><label for="bot_token">Bot token</label>@components.Input("bot_token", "Paste Telegram bot token", "")<p>Keep this token private; it grants access to your bot.</p></div>
	</div>
}

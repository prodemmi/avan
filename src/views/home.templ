package views

import "fmt"

type HomeStatus struct {
	Nodes int
	Healthy int
	Unhealthy int
	Consumers int
}

templ Home(status HomeStatus) {
	<div class="dashboard-home">
		<section class="dashboard-hero">
			<div class="dashboard-hero-copy">
				<span class="dashboard-kicker">YOUR MESSAGING WORKSPACE</span>
				<h1>Welcome to Avan</h1>
				<p>Send messages seamlessly through multiple providers (SMS, Email, Telegram, Slack, Webhook).</p>
				<a class="dashboard-primary-link" href="/dashboard/messages?page=0"><i class="ri-chat-new-line"></i> View messages <i class="ri-arrow-right-line"></i></a>
			</div>
			<div class="dashboard-hero-art" aria-hidden="true"><i class="ri-send-plane-2-line"></i></div>
		</section>
		<section class="dashboard-section">
			<div class="dashboard-section-heading">
				<div><span class="dashboard-kicker">A FEW QUICK STEPS</span><h2>Get started</h2></div>
				<p>Set up your workspace and start sending.</p>
			</div>
			<div class="dashboard-grid">
				@QuickActionCard("ri-router-line", "Manage providers", "Connect SMS, email, and chat providers.", "/dashboard/providers")
				@QuickActionCard("ri-file-list-3-line", "Create templates", "Prepare reusable message templates.", "/dashboard/templates")
				@QuickActionCard("ri-key-2-line", "API keys", "Create credentials for your integrations.", "/dashboard/api-keys")
				@QuickActionCard("ri-settings-3-line", "Settings", "Manage preferences for your application.", "/dashboard/settings")
				@QuickActionCard("ri-code-s-slash-line", "Developer", "API guide, API keys, and interactive Swagger.", "/dashboard/developer")
			</div>
		</section>
		<section class="dashboard-section">
			<div class="dashboard-section-heading">
				<div><span class="dashboard-kicker">LIVE OVERVIEW</span><h2>System Status &amp; Service Health</h2></div>
				<a class="dashboard-health-link" href="/dashboard/analysis">View detailed health</a>
			</div>
			<div class="dashboard-health-grid">
				<div class="dashboard-health-card"><strong>Database (PostgreSQL)</strong><span><i class="ri-checkbox-circle-fill" aria-hidden="true"></i> Connected</span></div>
				<div class="dashboard-health-card"><strong>Redis queue</strong><span><i class="ri-checkbox-circle-fill" aria-hidden="true"></i> Connected · { fmt.Sprint(status.Consumers) } consumers configured</span></div>
				<div class="dashboard-health-card"><strong>Cluster nodes</strong><span>{ fmt.Sprintf("%d healthy · %d unhealthy of %d", status.Healthy, status.Unhealthy, status.Nodes) }</span></div>
			</div>
		</section>
	</div>
}

templ QuickActionCard(icon string, title string, description string, link string) {
	<a href={ templ.URL(link) } class="dashboard-card">
		<span class="dashboard-card-icon"><i class={ icon } aria-hidden="true"></i></span>
		<span class="dashboard-card-copy"><strong>{ title }</strong><span>{ description }</span></span>
		<i class="ri-arrow-right-up-line dashboard-card-arrow" aria-hidden="true"></i>
	</a>
}

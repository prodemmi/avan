package views

templ Home() {
	<div class="flex flex-col space-y-6">
		<!-- Welcome Section -->
		<div class="bg-blue-500 text-white p-8 rounded-lg shadow-md dark:bg-blue-600">
			<h1 class="text-3xl font-bold">Welcome to Avan</h1>
			<p class="mt-3 text-lg">Send messages seamlessly through multiple providers (SMS, Email, Telegram, Slack, Webhook).</p>
		</div>
		<!-- Get Started Guide -->
		<div class="bg-white p-6 rounded-lg shadow-md dark:bg-gray-800 dark:text-gray-200">
			<h2 class="text-xl font-bold mb-4">🚀 Get Started</h2>
			<p class="text-gray-700 dark:text-gray-300">New here? Follow these steps:</p>
			<ul class="list-decimal pl-4 mt-2">
				<li>Configure your providers in <a href="/dashboard/providers" class="text-blue-500 dark:text-blue-400">Manage Providers</a></li>
				<li>Set up your application settings in <a href="/dashboard/settings" class="text-blue-500 dark:text-blue-400">Settings</a></li>
				<li>Create your message templates in <a href="/dashboard/templates" class="text-blue-500 dark:text-blue-400">Templates</a></li>
				<li>Send messages by API</li>
			</ul>
		</div>
		<!-- Quick Actions -->
		<div class="grid grid-cols-2 gap-6">
			@QuickActionCard("🔑 API Keys", "Generate and manage API keys for integrations", "/dashboard/api-keys")
			@QuickActionCard("⚙️ Settings", "Configure application settings", "/dashboard/settings")
			@QuickActionCard("🔌 Manage Providers", "Add or edit message providers", "/dashboard/providers")
			@QuickActionCard("📂 View Logs", "Check application logs", "/dashboard/logs")
		</div>
		<!-- Recent Activity -->
		<div class="bg-white shadow-md p-6 rounded-lg dark:bg-gray-800 dark:text-gray-200">
			<h2 class="text-xl font-bold mb-4">📢 Recent Activity</h2>
			<ul class="list-disc pl-8 text-gray-700 dark:text-gray-300">
				<li>Message sent to <b>Telegram</b> - 2 minutes ago</li>
				<li>New provider <b>SMS Gateway</b> added - 1 hour ago</li>
				<li>Admin changed <b>application settings</b> - Yesterday</li>
			</ul>
		</div>
		<!-- Help Section -->
		<div class="bg-white p-6 rounded-lg shadow-md dark:bg-gray-800 dark:text-gray-200">
			<h2 class="text-xl font-bold">❓ Need Help?</h2>
			<p class="mt-2">Check out our documentation or contact support.</p>
			<a href="/dashboard/help" class="mt-4 inline-block bg-blue-500 text-white px-4 py-2 rounded dark:bg-blue-600">View Docs</a>
		</div>
	</div>
}

templ QuickActionCard(title string, description string, link string) {
	<a href={ templ.URL(link) } class="bg-white shadow-md rounded-lg p-6 text-lg font-semibold hover:shadow-lg transition dark:bg-gray-800 dark:text-gray-200 dark:hover:shadow-md">
		<h3>{ title }</h3>
		<p class="text-sm text-gray-600 dark:text-gray-400">{ description }</p>
	</a>
}

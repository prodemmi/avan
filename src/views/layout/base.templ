package layout

templ Layout(content templ.Component, baseMenu string, menuItems []MenuItem) {
	{{ theme := ctx.Value("theme").(string)}}
	<html lang="en" dir="ltr" class={ theme }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Avan</title>
			<link href="/public/styles.css" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet"/>
			<script src="/public/admin.js" defer></script>
		</head>
		<body class="admin-shell text-gray-900 dark:text-gray-200">
			@Sidebar()
			<div class="admin-main bg-gray-100 dark:bg-gray-900">
				<header class="admin-topbar">
					<div class="admin-topbar-title">
						<span class="admin-eyebrow">WORKSPACE</span>
						<strong>Admin console</strong>
					</div>
					<button class="language-toggle" id="language-toggle" type="button" aria-label="Switch language" title="Switch language">
						<i class="ri-translate-2"></i>
						<span>EN</span><span class="language-divider">/</span><span lang="fa">فارسی</span>
					</button>
				</header>
				@MenuBar(baseMenu, menuItems)
				<main class="admin-content">
					if messages, ok := ctx.Value("messages").([]string); ok {
						for _, message := range messages {
							<div class="admin-alert admin-alert-info mb-4" role="alert">
								<div class="bg-blue-500 dark:bg-blue-700 text-white font-bold rounded-t px-4 py-2">
									Info
								</div>
								<div class="border border-t-0 border-blue-400 dark:border-blue-600 rounded-b bg-blue-100 dark:bg-blue-950 px-4 py-3 text-blue-700 dark:text-blue-300">
									<p>{ message }</p>
								</div>
							</div>
						}
					}
					if errorMessages, ok := ctx.Value("errors").([]string); ok {
						for _, errorMessage := range errorMessages {
							<div class="admin-alert admin-alert-error mb-4" role="alert">
								<div class="bg-red-500 dark:bg-red-700 text-white font-bold rounded-t px-4 py-2">
									Error
								</div>
								<div class="border border-t-0 border-red-400 dark:border-red-600 rounded-b bg-red-100 dark:bg-red-950 px-4 py-3 text-red-700 dark:text-red-300">
									<p>{ errorMessage }</p>
								</div>
							</div>
						}
					}
					@content
				</main>
			</div>
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					const scrollContainer = document.querySelector(".admin-content");
					const scrollPosition = sessionStorage.getItem("scrollPosition");
					if (scrollPosition) scrollContainer.scrollTo(0, Number(scrollPosition));
					scrollContainer.addEventListener("scrollend", function () {
						sessionStorage.setItem("scrollPosition", scrollContainer.scrollTop);
					});
				});
			</script>

			<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.min.js" integrity="sha512-L0Shl7nXXzIlBSUUPpxrokqq4ojqgZFQczTYlGjzONGTDAcLremjwaWv5A+EDLnxhQzY5xUZPWLOLqYRkY0Cbw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
		</body>
	</html>
}

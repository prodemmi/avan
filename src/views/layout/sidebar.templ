package layout

import (
	"avan/internal/db/sqlc"
	"fmt"
)

templ SidebarItem(title string, url string, icon string) {
	<a class="admin-nav-link" href={ templ.URL(url) } aria-label={ title } title={ title }>
		if len(icon) > 0 {
			<i class={ fmt.Sprintf("%s ri-lg", icon) } aria-hidden="true"></i>
		}
		<span>{ title }</span>
	</a>
}

templ WorkspaceSwitcher(workspaces []sqlc.Workspace, selected sqlc.Workspace) {
	<form class="workspace-switcher" action="/dashboard/switch-workspace" method="GET">
		<label class="sr-only" for="active-workspace">Workspace</label>
		<select id="active-workspace" name="workspace-id" aria-label="Workspace" onchange="this.form.requestSubmit()">
			for _, workspace := range workspaces {
				<option value={ fmt.Sprint(workspace.ID) } selected?={ workspace.ID == selected.ID }>{ workspace.Name }</option>
			}
		</select>
	</form>
}

templ Sidebar() {
	{{ primaryColor := safePrimaryColor(ctx.Value("primaryColor").(string))}}

	<aside class="admin-sidebar text-white dark:text-gray-300" style={ fmt.Sprintf("background-color: %s", primaryColor) }>
		<a href="/dashboard/" class="admin-brand" aria-label="Avan home">
			<span class="admin-brand-name">Avan</span>
		</a>
		<div class="admin-workspace">
			<span class="admin-sidebar-caption">WORKSPACE</span>
			<strong>{ ctx.Value("workspace").(sqlc.Workspace).Name }</strong>
		</div>
		<div class="admin-nav-wrap">
			<span class="admin-sidebar-caption">OVERVIEW</span>
			<nav class="admin-nav">
				@SidebarItem("Home", "/dashboard/", "ri-home-2-fill")
				@SidebarItem("Providers", "/dashboard/providers?page=0", "ri-bank-line")
				@SidebarItem("Templates", "/dashboard/templates?page=0", "ri-layout-horizontal-line")
				@SidebarItem("Messages", "/dashboard/messages?page=0", "ri-chat-3-line")
				@SidebarItem("Analysis & Service Health", "/dashboard/analysis", "ri-pie-chart-2-line")
			</nav>
			<span class="admin-sidebar-caption admin-sidebar-caption-manage">MANAGE</span>
			<nav class="admin-nav">
				@SidebarItem("Users", "/dashboard/users", "ri-user-3-line")
				@SidebarItem("API Keys", "/dashboard/api-keys", "ri-key-2-line")
				@SidebarItem("Workspaces", "/dashboard/workspaces", "ri-building-2-line")
				@SidebarItem("Settings", "/dashboard/settings", "ri-settings-3-line")
				@SidebarItem("Developer", "/dashboard/developer/", "ri-code-s-slash-line")
			</nav>
		</div>
		<a class="admin-logout" href="/auth/logout"><i class="ri-logout-box-r-line" aria-hidden="true"></i><span>Logout</span></a>
	</aside>
}

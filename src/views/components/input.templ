package components

templ Input(name, placeholder, defaultValue string) {
	<input
		class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 dark:text-white bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 leading-tight focus:outline-none focus:shadow-outline focus:border-blue-500 dark:focus:border-blue-400"
		id={ name }
		name={ name }
		value={ defaultValue }
		type="text"
		required
		placeholder={ placeholder }
	/>
}

package providers

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
	"avan/views/providers/edit_config_forms"
	"fmt"
)

templ Edit(provider sqlc.Provider, configType string, config interface{}) {
	<div class="flex justify-between">
		<b>Edit Provider "{ provider.Name }"</b>
		<div></div>
	</div>
	<form class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 dark:bg-gray-800" action={ templ.URL(fmt.Sprintf("/dashboard/providers/%d/edit", provider.ID)) } method="POST">
		<div class="mb-4">
			<label class="block text-gray-700 text-sm font-bold mb-2 dark:text-gray-300" for="name">
				Provider name
			</label>
			@components.Input("name", "Enter provider name", provider.Name)
		</div>
		switch configType {
			case "sms":
				@edit_config_forms.SmsForm(config.(sqlc.SmsConfig))
			case "email":
				@edit_config_forms.EmailForm(config.(sqlc.EmailConfig))
			case "telegram":
				@edit_config_forms.TelegramForm(config.(sqlc.TelegramConfig))
			case "slack":
				@edit_config_forms.SlackForm(config.(sqlc.SlackConfig))
			case "webhook":
				@edit_config_forms.WebhookForm(config.(sqlc.WebhookConfig))
		}
		<div class="mt-4" style="width: 20dvw">
			@components.SubmitButton(fmt.Sprintf("Update %s config", configType))
		</div>
	</form>
}

package providers

import (
	"avan/views/components"
	"avan/views/providers/create_config_forms"
	"fmt"
)

templ Create(configType string) {
	<div class="flex justify-between">
		<b>Create Provider</b>
		<div></div>
	</div>
	<form class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 dark:bg-gray-800" action={ templ.URL(fmt.Sprintf("/dashboard/providers/create/%s", configType)) } method="POST">
		<div class="mb-4">
			<label class="block text-gray-700 text-sm font-bold mb-2 dark:text-gray-300" for="type">
				Provider Type
			</label>
			{{
	options := []components.SelectOption{
		{Value: "sms", Label: "Sms"},
		{Value: "email", Label: "Email"},
		{Value: "telegram", Label: "Telegram"},
		{Value: "slack", Label: "Slack"},
		{Value: "webhook", Label: "Webhook"},
	}
			}}
			@components.Select("type", options, configType)
		</div>
		<div class="mb-4">
			<label class="block text-gray-700 text-sm font-bold mb-2" for="name">
				Provider name
			</label>
			@components.Input("name", "Enter provider name", "")
		</div>
		switch configType {
			case "sms":
				@create_config_forms.SmsForm()
			case "email":
				@create_config_forms.EmailForm()
			case "telegram":
				@create_config_forms.TelegramForm()
			case "slack":
				@create_config_forms.SlackForm()
			case "webhook":
				@create_config_forms.WebhookForm()
		}
	</form>
	<script>
        const typeValue = document.querySelector("[name=type]");
        if (typeValue) {
            typeValue.onchange = (e) => {
                location.href = "/dashboard/providers/create/" + e.target.value
            }
        }
    </script>
}

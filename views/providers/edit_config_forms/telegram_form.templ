package edit_config_forms

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
)

templ TelegramForm(config sqlc.TelegramConfig) {
	<div class="flex flex-col gap-4">
		<div>
			<label class="block text-gray-700 text-sm font-bold mb-2 dark:text-gray-300" for="bot_token">
				Bot Token
			</label>
			@components.Input("bot_token", "Enter Telegram bot token", config.BotToken)
		</div>
	</div>
}

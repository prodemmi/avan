package create_config_forms

import "avan/views/components"

templ TelegramForm() {
	<div class="flex flex-col gap-4">
		<div>
			<label class="block text-gray-700 text-sm font-bold mb-2 dark:text-gray-300" for="bot_token">
				Bot Token
			</label>
			@components.Input("bot_token", "Enter Telegram bot token", "")
		</div>
		<div class="mt-4" style="width: 20dvw">
			@components.SubmitButton("Create Telegram Config")
		</div>
	</div>
}

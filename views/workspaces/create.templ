package workspaces

import "avan/views/components"

templ WorkspacesCreate() {
	<div class="flex justify-between">
		<b>Create Workspace</b>
		<div></div>
	</div>
	<div class="w-full">
		<form class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 dark:bg-gray-900" action="/dashboard/workspaces" method="POST">
			<div class="mb-4">
				<label class="block text-gray-700 text-sm font-bold mb-2 dark:text-gray-100" for="name">
					Name
				</label>
				@components.Input("name", "Workspace name", "")
			</div>
			@components.SubmitButton("Create")
		</form>
	</div>
}

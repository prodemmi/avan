package workspaces

import (
	"avan/internal/db/sqlc"
	"avan/views/components"
	"fmt"
)

templ Edit(workspace sqlc.Workspace) {
	<div class="flex justify-between">
		<b>Edit Workspace { workspace.Name }</b>
		<div></div>
	</div>
	<div class="w-full">
		<form class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 dark:bg-gray-900" action={ templ.URL(fmt.Sprintf("/dashboard/workspaces/%d/edit", workspace.ID)) } method="POST">
			<div class="mb-4">
				<label class="block text-gray-700 text-sm font-bold mb-2 dark:text-gray-100" for="name">
					Name
				</label>
				@components.Input("name", "Workspace name", workspace.Name)
			</div>
			@components.SubmitButton("Update Workspace")
		</form>
	</div>
}
